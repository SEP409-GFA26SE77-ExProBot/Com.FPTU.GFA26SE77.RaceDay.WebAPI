{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "public-api": {
        "ClusterId": "raceday-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "admin-internal-only": {
        "ClusterId": "raceday-api",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "AuthorizationPolicy": "default",
        "Metadata": {
          "Note": "In Development, admin is proxied for local testing. In Production public gateway must NOT include this route; use internal network / VPN gateway instead."
        }
      }
    },
    "Clusters": {
      "raceday-api": {
        "Destinations": {
          "api1": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  }
}
