{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "positioning-api": {
        "ClusterId": "raceday-api",
        "Match": {
          "Path": "/api/v1/positioning/{**catch-all}"
        }
      },
      "public-api": {
        "ClusterId": "raceday-api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "RateLimiterPolicy": "gateway"
      }
    },
    "Clusters": {
      "raceday-api": {
        "Destinations": {
          "api1": {
            "Address": "http://localhost:5080/"
          }
        }
      }
    }
  }
}
