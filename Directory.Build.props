<Project>
  <!-- Pin patched transitive deps only where MongoDB/EF Design actually land. -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('Infrastructure'))">
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>
</Project>
