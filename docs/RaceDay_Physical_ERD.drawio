<mxCell id="pn1" value="PHYSICAL ERD — PostgreSQL schemas + MongoDB AuditLog&#xa;PK = primary key · FK = in-schema foreign key&#xa;LogicalId = Guid reference across modules (NO DB FK — modular monolith rule)&#xa;Outbox tables per transactional module omitted for clarity (iam/payment/map/device)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=10;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="520" height="100" as="geometry"/></mxCell>
