# Copy to `.env` at repo root and fill real values.
# `.env` is gitignored — never commit secrets.

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=YOUR_POSTGRES_PASSWORD
ConnectionStrings__MongoDb=mongodb://localhost:27017
ConnectionStrings__Redis=localhost:6379
ConnectionStrings__RabbitMq=amqp://guest:guest@localhost:5672

MongoDb__Database=raceday

Jwt__Issuer=raceday
Jwt__Audience=raceday-clients
Jwt__SigningKey=GENERATE_A_LONG_RANDOM_BASE64_KEY_AT_LEAST_32_CHARS

# Used only when seeding empty IAM users table (dev/bootstrap).
Iam__SeedPassword=CHANGE_ME_SEED_PASSWORD

# Gmail SMTP — dùng App Password (Google Account → Security → 2-Step → App passwords).
# Ghi 16 ký tự liền, không khoảng trắng. Để trống Smtp__Host = log OTP ra console (dev).
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=YOUR_GMAIL@gmail.com
Smtp__Password=YOUR16CHARGMAILAPPPASSWORD
Smtp__From=YOUR_GMAIL@gmail.com
Smtp__FromName=RaceDay
Smtp__UseSsl=true

# File storage: Local (dev) | R2 (Cloudflare). Create-event only stores fileUrl/fileName.
Storage__Provider=Local
Storage__PublicBaseUrl=http://localhost:5080
# Storage__R2__AccountId=
# Storage__R2__AccessKeyId=
# Storage__R2__SecretAccessKey=
# Storage__R2__Bucket=raceday-uploads
# Storage__PublicBaseUrl=https://cdn.your-domain.com

# PayOS — DEV: UseMock=true (hành vi giống live: checkout → pay/webhook-equivalent → sync → pending_approval).
# LIVE sau này: UseMock=false + điền 3 key từ my.payos.vn + webhook public URL.
PayOS__UseMock=true
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__BaseUrl=https://api-merchant.payos.vn
# Base URL API (mock checkout link). Mặc định lấy Storage__PublicBaseUrl.
PayOS__PublicApiBaseUrl=http://localhost:5080
